<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:DualSync.App">
  <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
  <Style x:Key="DashboardExpander" TargetType="Expander">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <StackPanel>
            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Stretch">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="HeaderBorder" Background="{StaticResource InputBrush}" CornerRadius="6" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                      <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                      <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="1"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
              <DockPanel>
                <TextBlock x:Name="Chevron" Text="▾" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" FontSize="16"/>
                <ContentPresenter Content="{TemplateBinding Header}"/>
              </DockPanel>
            </ToggleButton>
            <ContentPresenter x:Name="ExpandedContent" ContentSource="Content" Visibility="Collapsed" Margin="0,14,0,0"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Chevron" Property="Text" Value="▴"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="SavedEqPicker">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox ItemsSource="{Binding Names}" SelectedItem="{Binding SelectedName}" AutomationProperties.Name="Saved custom EQ preset"
                  Margin="0,0,8,0" ToolTip="Choose a saved EQ, then press Load EQ"/>
        <Button Grid.Column="1" Content="Load EQ" Command="{Binding LoadCommand}" IsEnabled="{Binding HasSelection}" Padding="10,8" Margin="0,0,6,0"/>
        <Button Grid.Column="2" Content="Delete" Command="{Binding DeleteCommand}" IsEnabled="{Binding HasSelection}" Padding="10,8" Margin="0"/>
      </Grid>
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="Custom EQ preset name"
                 ToolTip="Name the current EQ to save it. An existing name replaces that saved EQ." Margin="0,0,8,0"/>
        <Button Grid.Column="1" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" Padding="10,8" Margin="0"/>
      </Grid>
    </StackPanel>
  </DataTemplate>

  <DataTemplate x:Key="EqPanel">
    <StackPanel>
      <DockPanel>
        <TextBlock Text="10-band equalizer" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <CheckBox Content="Enabled" IsChecked="{Binding EqEnabled}" HorizontalAlignment="Right"/>
      </DockPanel>
      <local:EqCurve Settings="{Binding Snapshot}" CurveBrush="{Binding AccentColor}" Height="115" Margin="0,8,0,5" AutomationProperties.Name="Equalizer frequency response"/>
      <TextBlock Text="EQ response · dB / Hz" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,12"/>
      <ItemsControl ItemsSource="{Binding Bands}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="{Binding Gain, StringFormat={}{0:+0.0;-0.0;0.0}}" FontSize="11" HorizontalAlignment="Center"/>
              <Slider Orientation="Vertical" Height="115" Minimum="-12" Maximum="12" TickFrequency="1" SmallChange="0.5"
                      Foreground="{Binding DataContext.AccentColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      Value="{Binding Gain}" AutomationProperties.Name="{Binding Label, StringFormat={}{0} Hz gain dB}"/>
              <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="Built-in curves" Style="{StaticResource Muted}" FontSize="12" Margin="0,18,0,6"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox ItemsSource="{Binding PresetNames}" SelectedItem="{Binding Preset}" AutomationProperties.Name="EQ preset" Margin="0,0,12,0"/>
        <Button Grid.Column="1" Content="Reset EQ" Command="{Binding ResetEqCommand}"/>
      </Grid>
      <TextBlock Text="Custom EQ presets" FontWeight="SemiBold" Margin="0,18,0,8"/>
      <ContentControl Content="{Binding SavedEq}" ContentTemplate="{StaticResource SavedEqPicker}"/>
      <TextBlock Text="Save this curve for either speaker. Use a new name to keep another version."
                 Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
      <TextBlock Text="{Binding HeadroomText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"/>
    </StackPanel>
  </DataTemplate>

  <DataTemplate x:Key="SpeakerCard">
    <Border Style="{StaticResource Card}" Padding="16">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Border Width="28" Height="28" CornerRadius="6" Background="#26342F" Margin="0,0,10,0"><TextBlock Text="{Binding Marker}" Foreground="{Binding AccentColor}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <ComboBox ItemsSource="{Binding Devices}" SelectedValuePath="Id" SelectedValue="{Binding DeviceId}"
                  IsEnabled="{Binding DataContext.CanSelectDevices, RelativeSource={RelativeSource AncestorType=Window}}"
                  AutomationProperties.Name="{Binding Title, StringFormat={}{0} device}" Margin="0,12,0,10"/>

        <DockPanel Margin="0,3,0,0">
          <CheckBox Content="Mute" IsChecked="{Binding Muted}" DockPanel.Dock="Right" Margin="16,0,0,0"/>
          <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" DockPanel.Dock="Right" Margin="10,0,0,0"/>
          <TextBlock Text="Volume" FontWeight="SemiBold"/>
        </DockPanel>
        <Slider Value="{Binding Volume}" Foreground="{Binding AccentColor}" AutomationProperties.Name="{Binding Title, StringFormat={}{0} volume}"/>
        <ProgressBar Value="{Binding Meter}" Maximum="100" Height="2" Foreground="{Binding AccentColor}"
                     Background="#303B47" BorderThickness="0" Margin="0,0,0,10"/>

        <Border Background="#11171D" CornerRadius="6" Padding="11,10" Margin="0,0,0,10"
                ToolTip="Queue plus added delay only. Windows output buffering, 5 ms peak protection, and Bluetooth/device latency are additional.">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/>
              <ColumnDefinition Width="24"/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Queue" Style="{StaticResource Muted}" FontSize="11"/>
              <TextBlock Text="{Binding QueueDisplay}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="+" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18"/>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Added delay" Style="{StaticResource Muted}" FontSize="11"/>
              <TextBlock Text="{Binding AddedDelayDisplay}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="3" Text="=" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18"/>
            <StackPanel Grid.Column="4">
              <TextBlock Text="Final buffer" Foreground="{Binding AccentColor}" FontSize="11"/>
              <TextBlock Text="{Binding FinalBufferDisplay}" Foreground="{Binding AccentColor}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
        <DockPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button Content="−1 ms" Command="{Binding DelayStepCommand}" CommandParameter="-1" IsEnabled="{Binding CanDecreaseDelay}"
                    Padding="11,7" AutomationProperties.Name="{Binding Title, StringFormat=Decrease {0} delay by 1 millisecond}"/>
            <Button Content="+1 ms" Command="{Binding DelayStepCommand}" CommandParameter="1" IsEnabled="{Binding CanIncreaseDelay}"
                    Padding="11,7" Margin="0" AutomationProperties.Name="{Binding Title, StringFormat=Increase {0} delay by 1 millisecond}"/>
          </StackPanel>
          <TextBlock Text="Added delay" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <Slider Minimum="0" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DelayMs}"
                IsEnabled="{Binding ManualDelayEnabled}"
                Foreground="{Binding AccentColor}"
                SmallChange="1" LargeChange="10" AutomationProperties.Name="{Binding Title, StringFormat={}{0} delay milliseconds}"/>
        <TextBlock Text="{Binding DelayHint}" Style="{StaticResource Muted}" FontSize="12"/>

        <TextBlock Text="Left / right routing" FontWeight="SemiBold" Margin="0,12,0,0"/>
        <ComboBox ItemsSource="{Binding ChannelOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ChannelMode}"
                  AutomationProperties.Name="{Binding Title, StringFormat={}{0} channel routing}" Margin="0,6,0,4"/>
        <TextBlock Text="{Binding RoutingDescription}" Style="{StaticResource Muted}" FontSize="12"/>
        <StackPanel Visibility="{Binding CustomMixEnabled, Converter={StaticResource BooleanVisibility}}" Margin="0,12,0,0">
          <DockPanel><TextBlock Text="Left contribution" FontSize="12"/><TextBlock Text="{Binding LeftMix, StringFormat={}{0:P0}}" HorizontalAlignment="Right" FontSize="12"/></DockPanel>
          <Slider Minimum="0" Maximum="1" Value="{Binding LeftMix}" AutomationProperties.Name="{Binding Title, StringFormat={}{0} custom left mix}"/>
          <DockPanel><TextBlock Text="Right contribution" FontSize="12"/><TextBlock Text="{Binding RightMix, StringFormat={}{0:P0}}" HorizontalAlignment="Right" FontSize="12"/></DockPanel>
          <Slider Minimum="0" Maximum="1" Value="{Binding RightMix}" AutomationProperties.Name="{Binding Title, StringFormat={}{0} custom right mix}"/>
          <TextBlock Text="Combined weights above 100% are normalized to prevent extra gain." Style="{StaticResource Muted}" FontSize="11"/>
        </StackPanel>

        <Expander Header="Equalizer &amp; custom presets" Style="{StaticResource DashboardExpander}" Margin="0,12,0,0"
                  AutomationProperties.Name="{Binding Title, StringFormat={}{0} equalizer dropdown}">
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EqPanel}"/>
        </Expander>
        <TextBlock Text="{Binding Telemetry}" Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
      </StackPanel>
    </Border>
  </DataTemplate>
</ResourceDictionary>
