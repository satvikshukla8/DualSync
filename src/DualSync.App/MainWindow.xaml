<Window x:Class="DualSync.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DualSync.App" Title="DualSync · alpha 5" Width="1240" Height="920" MinWidth="860" MinHeight="620" WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Dashboard.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="30,22,14,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,16,20"><StackPanel Orientation="Horizontal"><Border Background="#1C3D40" CornerRadius="12" Width="48" Height="48" Margin="0,0,14,0"><TextBlock Text="DS" Foreground="{StaticResource AccentBrush}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><StackPanel><TextBlock Text="DualSync" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Two speakers. Your sound." Style="{StaticResource Muted}" FontSize="12"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Setup help" Click="Help_Click"/><Button Content="{Binding PlaybackLabel}" Background="{StaticResource AccentBrush}" Foreground="#0C2426" FontWeight="SemiBold" Click="Playback_Click" IsEnabled="{Binding CanOperate}"/></StackPanel></DockPanel>
    <Border Grid.Row="1" Background="#162B32" CornerRadius="8" Padding="14,10" Margin="0,0,16,12"><TextBlock Text="{Binding Status}" Foreground="#B6E8DF" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></Border>
    <TabControl Grid.Row="2">
      <TabItem Header="Dashboard">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Border Style="{StaticResource Card}" Padding="18,14">
              <StackPanel>
                <TextBlock Text="Full setup profiles" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ComboBox x:Name="SavedProfile" ItemsSource="{Binding ProfileNames}" AutomationProperties.Name="Saved profile"
                            Margin="0,0,12,0" ToolTip="Choose a saved setup for both speakers"/>
                  <Button Grid.Column="1" Content="Load profile" Click="LoadProfile_Click" IsEnabled="{Binding CanOperate}"/>
                  <TextBox Grid.Column="2" x:Name="ProfileName" Text="My speakers" Margin="8,0,12,0" AutomationProperties.Name="Profile name"/>
                  <Button Grid.Column="3" Content="Save profile" Click="SaveProfile_Click" Margin="0"/>
                </Grid>
                <Expander Header="Manage profiles" Style="{StaticResource DashboardExpander}" Margin="0,12,0,0">
                  <StackPanel>
                    <WrapPanel>
                      <Button Content="Rename selected" Click="RenameProfile_Click"/>
                      <Button Content="Delete selected" Click="DeleteProfile_Click"/>
                      <Button Content="Reset current setup" Click="ResetAll_Click"/>
                    </WrapPanel>
                    <TextBlock Text="One profile stores both speakers' devices, EQ, routing, volumes, and delays. Loading stops playback so you can check the setup."
                               Style="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"/>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="22,16">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,30,0">
                  <DockPanel><Button Content="Set up audio cable" DockPanel.Dock="Right" Click="CableSetup_Click" IsEnabled="{Binding CanSelectDevices}" Padding="10,6" Margin="12,0,0,0"/><TextBlock Text="Audio source" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                  <ComboBox ItemsSource="{Binding Devices}" SelectedValuePath="Id" SelectedValue="{Binding SourceId}"
                            IsEnabled="{Binding CanSelectDevices}" AutomationProperties.Name="Audio source" Margin="0,9,0,5"/>
                  <TextBlock Text="Use a separate, silent source. Stop audio to change devices." Style="{StaticResource Muted}" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <DockPanel>
                    <TextBlock Text="Master volume" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Master, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </DockPanel>
                  <Slider Value="{Binding Master}" AutomationProperties.Name="Master volume" Margin="0,19,0,8"/>
                  <TextBlock Text="Individual speaker levels keep their proportions." Style="{StaticResource Muted}" FontSize="12"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Padding="18,14">
              <Expander Header="Dual EQ presets · save both speakers together" Style="{StaticResource DashboardExpander}" IsExpanded="True">
                <StackPanel>
                  <TextBlock Text="Save Speaker A and Speaker B's individual EQs as one preset. Loading applies each curve to its original side while audio keeps playing."
                             Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10"/>
                  <ContentControl Content="{Binding DualEq}" ContentTemplate="{StaticResource SavedEqPicker}" MaxWidth="720" HorizontalContentAlignment="Stretch"/>
                  <TextBlock Text="EQ presets change bands and EQ enabled state only. Full setup profiles above also save devices, routing, volumes, and delay."
                             Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
                </StackPanel>
              </Expander>
            </Border>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <ContentControl Content="{Binding A}" ContentTemplate="{StaticResource SpeakerCard}" VerticalAlignment="Top"/>
              <ContentControl Grid.Column="1" Content="{Binding B}" ContentTemplate="{StaticResource SpeakerCard}" VerticalAlignment="Top"/>
            </Grid>
            <TextBlock Text="Final buffer = live queue + added delay. This software subtotal excludes the 5 ms peak-protection lookahead, Windows output buffering, and Bluetooth/device latency. Use it alongside what you hear; matching subtotals does not guarantee synchronized speakers."
                       Style="{StaticResource Muted}" FontSize="12" Margin="3,0,24,14"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Settings"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Windows volume integration" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Windows source volume is the default: the Windows slider and mute control both speakers. The app master changes that source volume when you move it. App volume mode keeps a separate app gain but still respects Windows mute." Style="{StaticResource Muted}" Margin="0,10,0,10"/><ComboBox SelectedIndex="{Binding MasterModeIndex}" IsEnabled="{Binding CanSelectDevices}" AutomationProperties.Name="Master volume mode"><ComboBoxItem Content="App volume"/><ComboBoxItem Content="Windows source volume · recommended for VB-Cable"/></ComboBox><CheckBox Content="Source already applies Windows volume to captured audio (leave off for VB-Cable)" IsChecked="{Binding IncludesVolume}"/><TextBlock Text="Leave this unchecked for a VB-Cable whose native volume control is bypassed: DualSync applies the Windows level itself. Check it only if your source already scales captured audio, to avoid applying volume twice. Windows mute is always honored. Keyboard controls follow Windows' default output, which must match the source." Style="{StaticResource Muted}" FontSize="12"/><TextBlock Text="A dedicated DualSync virtual endpoint is still under evaluation. Audio cable setup can download and open VB-Audio's official installer after you opt in. Windows default devices stay unchanged." Style="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Background operation" FontSize="22" FontWeight="SemiBold"/><CheckBox x:Name="TrayPreference" Content="Close the window to the system tray" Checked="Preferences_Changed" Unchecked="Preferences_Changed"/><CheckBox x:Name="StartMinimizedPreference" Content="Open in the tray on the next launch" Checked="Preferences_Changed" Unchecked="Preferences_Changed"/><CheckBox x:Name="StartupPreference" Content="Launch DualSync when I sign in to Windows" Click="StartupPreference_Click"/><TextBlock Text="Audio starts only when you press Start. Tray controls provide speaker volume and mute, open the window, stop audio, or quit." Style="{StaticResource Muted}" FontSize="12"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Diagnostics" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding Diagnostic}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,18"/><StackPanel Orientation="Horizontal"><Button Content="Refresh devices" Click="Refresh_Click"/><Button Content="Copy diagnostic report" Click="CopyDiagnostics_Click"/><Button Content="Open data folder" Click="DataFolder_Click"/></StackPanel><TextBlock Text="Underruns include silence when the source is idle. Buffer drops during active playback can indicate clock drift or scheduling stalls. Clipped samples indicate the safety clamp was reached." Style="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0"/></StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <DockPanel Grid.Row="3" Margin="2,14,16,0"><TextBlock Text="DUALSYNC  /  0.1.0 ALPHA 5" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Settings save automatically" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/></DockPanel>
  </Grid>
</Window>
