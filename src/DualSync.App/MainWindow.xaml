<Window x:Class="DualSync.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DualSync.App"
        Title="DualSync · alpha 7" Icon="Assets/DualSync.ico" Width="1180" Height="900" MinWidth="860" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Dashboard.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid Margin="28,22,28,14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
        <Button Content="Setup guide" Click="Help_Click"/>
        <Button Content="{Binding PlaybackLabel}" Style="{StaticResource PrimaryButton}" Click="Playback_Click" IsEnabled="{Binding CanOperate}" MinWidth="120" Margin="0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Image Source="{StaticResource BrandMark}" Width="44" Height="44" Margin="0,0,13,0" AutomationProperties.Name="DualSync logo"/>
        <StackPanel><TextBlock Text="DualSync" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="One source. Two speakers. Your sound." Style="{StaticResource Muted}" FontSize="12"/></StackPanel>
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Background="#172B28" BorderBrush="#29453E" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
      <DockPanel><Ellipse Fill="{StaticResource AccentBrush}" Width="6" Height="6" DockPanel.Dock="Left" Margin="0,0,10,0"/><TextBlock Text="{Binding Status}" Foreground="#C7EBE2" FontSize="12" AutomationProperties.LiveSetting="Polite"/></DockPanel>
    </Border>
    <TabControl Grid.Row="2" x:Name="WorkspaceTabs">
      <TabItem Header="Dashboard" x:Name="DashboardTab">
        <ScrollViewer x:Name="DashboardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
          <StackPanel>
            <Border Style="{StaticResource Card}" Padding="18,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <DockPanel><Button Content="Audio cable…" DockPanel.Dock="Right" Click="CableSetup_Click" IsEnabled="{Binding CanSelectDevices}" Padding="10,3" Margin="8,0,0,0"/><TextBlock Text="AUDIO SOURCE" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/></DockPanel>
                  <ComboBox ItemsSource="{Binding Devices}" SelectedValuePath="Id" SelectedValue="{Binding SourceId}" IsEnabled="{Binding CanSelectDevices}" AutomationProperties.Name="Audio source" Margin="0,7,0,4"/>
                  <TextBlock Text="{Binding SourceHint}" Style="{StaticResource Muted}" FontSize="11"/>
                </StackPanel>
                <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,2"/>
                <StackPanel Grid.Column="2">
                  <DockPanel><TextBlock Text="{Binding Master, StringFormat={}{0:0}%}" DockPanel.Dock="Right" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="MASTER VOLUME" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/></DockPanel>
                  <Slider Value="{Binding Master}" AutomationProperties.Name="Master volume" Margin="0,11,0,7"/>
                  <TextBlock Text="Both speakers move together. Individual levels stay proportional." Style="{StaticResource Muted}" FontSize="11"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14,10">
              <StackPanel>
                <DockPanel>
                  <ProgressBar DockPanel.Dock="Right" Value="{Binding AutoSyncProgress, Mode=OneWay}" Width="100" Height="4" Maximum="100" Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0" Margin="14,0,0,0" AutomationProperties.Name="Auto Sync sampling progress"/>
                  <CheckBox Content="Auto Sync" IsChecked="{Binding AutoSyncEnabled}" DockPanel.Dock="Left" Margin="0,0,16,0" FontWeight="SemiBold" AutomationProperties.Name="Automatically align speaker buffers"/>
                  <TextBlock Text="{Binding AutoSyncStatus}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="{Binding AutoSyncDetails}" Style="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/>
                <TextBlock Text="Aligns the app's queues. Bluetooth and device latency are not measured." Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <ContentControl Content="{Binding A}" ContentTemplate="{StaticResource SpeakerCard}" VerticalAlignment="Top"/>
              <ContentControl Grid.Column="2" Content="{Binding B}" ContentTemplate="{StaticResource SpeakerCard}" VerticalAlignment="Top"/>
            </Grid>
            <Border Style="{StaticResource Card}" Padding="16,12">
              <Expander Header="Dual EQ presets · save both curves together" Style="{StaticResource DashboardExpander}">
                <StackPanel>
                  <TextBlock Text="Save the current EQ for A and B as one preset. Loading restores each curve to its original speaker during playback." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12"/>
                  <ContentControl Content="{Binding DualEq}" ContentTemplate="{StaticResource SavedEqPicker}" MaxWidth="700" HorizontalContentAlignment="Stretch"/>
                  <TextBlock Text="Includes the ten bands and enabled state for each speaker. Volume, devices, routing, and delay stay as they are." Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
                </StackPanel>
              </Expander>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,12">
              <Expander Header="Full setup profiles · keep your whole setup" Style="{StaticResource DashboardExpander}">
                <StackPanel>
                  <TextBlock Text="Saves devices, volume, routing, delay, and EQ for both speakers. Loading a full setup stops audio." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="SavedProfile" ItemsSource="{Binding ProfileNames}" AutomationProperties.Name="Saved profile" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Load profile" Click="LoadProfile_Click" IsEnabled="{Binding CanOperate}"/>
                    <TextBox Grid.Column="2" x:Name="ProfileName" Text="My speakers" MaxLength="80" Margin="8,0,8,0" AutomationProperties.Name="Profile name"/>
                    <Button Grid.Column="3" Content="Save profile" Click="SaveProfile_Click" Margin="0"/>
                  </Grid>
                  <WrapPanel Margin="0,10,0,0"><Button Content="Rename selected" Click="RenameProfile_Click"/><Button Content="Delete selected" Click="DeleteProfile_Click"/><Button Content="Reset current setup" Click="ResetAll_Click"/></WrapPanel>
                </StackPanel>
              </Expander>
            </Border>
            <TextBlock Text="Final buffer = queue + added delay. This is the app's software buffer; Windows, the 5 ms peak protector, and Bluetooth add more latency. Matching totals alone does not guarantee synchronized sound."
                       Style="{StaticResource Muted}" FontSize="11" Margin="2,0,4,10"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Setup" x:Name="SetupTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
          <StackPanel>
            <TextBlock Text="Get both speakers playing" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="Connect both speakers in Windows first, then follow these three steps. Keep the volume moderate for your first test." Style="{StaticResource Muted}" Margin="0,0,0,20"/>
            <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Text="01" FontSize="22" Foreground="{StaticResource AccentBrush}"/>
              <StackPanel Grid.Column="1"><TextBlock Text="Choose a source for your audio" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="The source receives your music before DualSync sends it to both speakers. A virtual cable keeps the original source silent. If you already have a suitable source, select it on the Dashboard." Style="{StaticResource Muted}" Margin="0,8,0,12"/>
                <WrapPanel><Button Content="Set up audio cable" Click="CableSetup_Click" IsEnabled="{Binding CanSelectDevices}" Style="{StaticResource PrimaryButton}"/><Button Content="Refresh devices" Click="Refresh_Click"/></WrapPanel>
                <TextBlock Text="VB-CABLE is provided by VB-Audio under its own donationware license. Installation is optional, needs administrator approval, and may need a restart." Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
              </StackPanel>
            </Grid></Border>
            <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Text="02" FontSize="22" Foreground="{StaticResource AccentBrush}"/>
              <StackPanel Grid.Column="1"><TextBlock Text="Send Windows audio to that source" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="In Windows Sound settings, choose the same source as your output. For VB-CABLE, this is usually CABLE Input. Your keyboard volume keys will then control the selected source." Style="{StaticResource Muted}" Margin="0,8,0,12"/>
                <Button Content="Open Windows Sound settings" Click="SoundSettings_Click" HorizontalAlignment="Left"/>
                <TextBlock Text="Note your previous Windows output so you can switch back when you stop using DualSync." Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
              </StackPanel>
            </Grid></Border>
            <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Text="03" FontSize="22" Foreground="{StaticResource AccentBrush}"/>
              <StackPanel Grid.Column="1"><TextBlock Text="Pick two speakers and press Start audio" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="On the Dashboard, choose different devices for Speaker A and Speaker B. Both must be different from the source. Mute each in turn to check that both receive audio." Style="{StaticResource Muted}" Margin="0,8,0,12"/>
                <Button Content="Choose my speakers" Click="Dashboard_Click" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/>
                <TextBlock Text="Turn on Auto Sync to align average queues, or leave it off and add delay to the speaker you hear first. Open its Equalizer dropdown to tune and save a curve." Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
              </StackPanel>
            </Grid></Border>
            <TextBlock Text="If another app is already forwarding this source, stop its duplicate route before starting DualSync. Stop audio before changing devices. Bluetooth timing may shift during longer sessions." Style="{StaticResource Muted}" FontSize="12" Margin="2,0,2,12"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0"><StackPanel>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Volume controls" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Choose how the master slider controls both speakers. Windows source volume is recommended for VB-CABLE." Style="{StaticResource Muted}" Margin="0,8,0,10"/>
            <ComboBox SelectedIndex="{Binding MasterModeIndex}" IsEnabled="{Binding CanSelectDevices}" AutomationProperties.Name="Master volume mode"><ComboBoxItem Content="App volume"/><ComboBoxItem Content="Windows source volume · recommended"/></ComboBox>
            <CheckBox Content="Source already applies Windows volume to captured audio" IsChecked="{Binding IncludesVolume}"/>
            <TextBlock Text="Leave this off for a VB-CABLE with native volume bypassed. Turn it on only if your source already changes the captured level; otherwise the volume gets applied twice. Windows mute is honored in either mode." Style="{StaticResource Muted}" FontSize="12"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Background operation" FontSize="20" FontWeight="SemiBold"/>
            <CheckBox x:Name="TrayPreference" Content="Close the window to the system tray" Checked="Preferences_Changed" Unchecked="Preferences_Changed"/>
            <CheckBox x:Name="StartMinimizedPreference" Content="Open in the tray on the next launch" Checked="Preferences_Changed" Unchecked="Preferences_Changed"/>
            <CheckBox x:Name="StartupPreference" Content="Launch DualSync when I sign in to Windows" Click="StartupPreference_Click"/>
            <TextBlock Text="Audio starts when you press Start audio. Right-click the tray icon for speaker volume, mute, playback, and Quit." Style="{StaticResource Muted}" FontSize="12"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><Expander Header="Diagnostics" Style="{StaticResource DashboardExpander}"><StackPanel>
            <TextBlock Text="{Binding Diagnostic}" FontFamily="Consolas" FontSize="12" Margin="0,0,0,14"/>
            <WrapPanel><Button Content="Refresh devices" Click="Refresh_Click"/><Button Content="Copy diagnostic report" Click="CopyDiagnostics_Click"/><Button Content="Open data folder" Click="DataFolder_Click"/></WrapPanel>
            <TextBlock Text="Underruns can include silence while the source is idle. Drops during active playback can indicate timing drift or a scheduling stall." Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/>
          </StackPanel></Expander></Border>
          <TextBlock Text="DualSync is a portable alpha. Settings are stored separately from the app, and updates are installed by replacing the portable folder after quitting." Style="{StaticResource Muted}" FontSize="12" Margin="2,2,2,12"/>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <DockPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="DUALSYNC  /  ALPHA 7" Style="{StaticResource Eyebrow}"/><TextBlock Text="Settings save automatically" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/></DockPanel>
  </Grid>
</Window>
